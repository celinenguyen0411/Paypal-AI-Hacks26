# Copy this file to .env and set your own backend-only Groq key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_S=20

# Local demo settings. This balance is fictional, not a connected bank account.
MAP_DEMO_MODE=true
DEMO_SAFE_TO_SPEND_CENTS=6400
MAP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional overrides; default paths resolve beside main.py.
# MAP_DB_PATH=map.sqlite3
# MAP_PLACES_PATH=data/raw/entities.json
